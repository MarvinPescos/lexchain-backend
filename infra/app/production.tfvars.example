environment        = "production"
aws_profile        = "lexchain"
backup_bucket_name = "lexchain-production-backups-CHANGE-ME"
backup_db_bucket_name         = "lexchain-production-db-hourly-CHANGE-ME"
backup_db_monthly_bucket_name = "lexchain-production-db-monthly-CHANGE-ME"

# App box: everything except Marker.
instance_type  = "m7i-flex.large"
root_volume_gb = 40

# Marker on its own GPU box.
marker                = true
marker_instance_type  = "g4dn.xlarge"
marker_root_volume_gb = 100
