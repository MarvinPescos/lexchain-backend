environment = "staging"
aws_profile = "lexchain"
bucket_name = "lexchain-staging-backups-CHANGE-ME"

# Test data: short, overridable locks.
retention_mode = "GOVERNANCE"
retention_days = 1

# Database dumps.
db_bucket_name         = "lexchain-staging-db-hourly-CHANGE-ME"
db_monthly_bucket_name = "lexchain-staging-db-monthly-CHANGE-ME"

# Same rule as above. Monthly becomes the firm's record-retention period.
db_retention_mode         = "GOVERNANCE"
db_hourly_retention_days  = 7
db_monthly_retention_days = 1

# Told when hourly dumps stop. Confirm the SNS email after the first apply.
alert_email = "CHANGE-ME@example.com"

# The RDS copy costs money: true only during validation, then false and apply.
rds = false
