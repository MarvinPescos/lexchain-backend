environment = "production"
aws_profile = "lexchain"
bucket_name = "lexchain-production-backups-CHANGE-ME"

# Keep GOVERNANCE / 1 until this is real production; COMPLIANCE is irreversible.
retention_mode = "GOVERNANCE"
retention_days = 1

# Real production: put the bucket in its own account (aws_profile above) and
# set the app's account id here.
# app_account_id = "111111111111"
