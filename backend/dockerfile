FROM python:3.11-slim

# 1. Environment Variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup --gid 1000 appgroup && \
    adduser --uid 1000 --gid 1000 --home /home/appuser --shell /bin/bash --disabled-password --gecos "" appuser

RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    tesseract-ocr \
 && rm -rf /var/lib/apt/lists/*

# pg_dump refuses a server newer than itself, so this must be at least
# Supabase's Postgres major (`select version();`). Debian's own package lags.
ARG PG_CLIENT_MAJOR=17
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && install -d /etc/apt/keyrings \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /etc/apt/keyrings/pgdg.asc \
 && . /etc/os-release \
 && echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update && apt-get install -y --no-install-recommends postgresql-client-${PG_CLIENT_MAJOR} \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade --retries 10 --timeout 120 -r requirements.txt

# Installed straight from the release wheel rather than `spacy download`, which
# gives no retry control — the GitHub asset host is slow enough to time out and
# fail the whole build. Pinned so the model matches spacy>=3.7,<4.0 reproducibly.
RUN pip install --no-cache-dir --retries 10 --timeout 120 \
    "en_core_web_sm @ https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl"

COPY --chown=appuser:appgroup . .

USER appuser

# The schema is brought to head before the API serves a request, so code never
# runs against a database missing its tables.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]